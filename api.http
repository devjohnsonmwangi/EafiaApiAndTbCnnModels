  "email": "radiologist@tbdetection.com",
  "password": "SecurePassword123!",
  "firstName": "Dr.",
  "lastName": "Jones",
  "role": "physician",
  "specialization": "Chest Radiologist",
  "license": "LIC789012",
  "phone": "+1234567892"
}

### 2.4 Login Admin User
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@tbdetection.com",
  "password": "SecurePassword123!"
}

### Copy access_token from response above and paste into @adminToken at the top
### Copy refresh_token from response above and paste into @adminRefreshToken at the top
### Copy user.id from response above and paste into @userId at the top

### 2.5 Login Physician User
# @name loginPhysician
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "physician@tbdetection.com",
  "password": "SecurePassword123!"
}

### Copy access_token from response above and paste into @physicianToken at the top
### Copy refresh_token from response above and paste into @physicianRefreshToken at the top
### Copy user.id from response above and paste into @physicianId at the top

### 2.6 Refresh Admin Token
POST {{baseUrl}}/auth/refresh-token
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "refresh_token": "{{adminRefreshToken}}"
}

